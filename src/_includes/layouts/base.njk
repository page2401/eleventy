{% macro renderNavItem(entry, currentUrl) %}
<li>
  <a class="nav-link{% if entry.url == currentUrl %} active{% endif %}" href="{{ entry.url }}">
    {{ entry.title }}
  </a>
  {%- if entry.children and entry.children.length -%}
  <ul class="nav-sublist">
    {%- for child in entry.children -%}
      {{ renderNavItem(child, currentUrl) }}
    {%- endfor -%}
  </ul>
  {%- endif -%}
</li>
{% endmacro -%}
{%- set hasMermaid = ('class="mermaid"' in content) -%}
{%- set tocItems = (content | extractToc) -%}
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if page.url == "/" %}{{ site.title }}{% else %}{{ title }} · {{ site.title }}{% endif %}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}" />
    {%- endif %}
    <link rel="stylesheet" href="/assets/katex.min.css" />
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <span>{{ site.title }}</span>
        <span class="version-pill">v{{ site.version }} · ESM</span>
        {%- if not hasMermaid %}
        <span class="zero-js-pill" title="当前页面构建产物含 0 个 script 标签">0 KB Client JS</span>
        {%- endif %}
      </a>
      <div class="topbar-actions">
        <a href="{{ site.portal }}" target="_top">对比总站</a>
        <a href="{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
        <button
          class="theme-btn"
          id="eleventy-theme-toggle"
          type="button"
          onclick="var r=document.documentElement,d=!(r.getAttribute('data-theme')==='dark'||r.classList.contains('dark'));r.classList.toggle('dark',d);r.setAttribute('data-theme',d?'dark':'light');try{localStorage.setItem('eleventy-benchmark-theme',d?'dark':'light')}catch(e){}if(window.__renderEleventyMermaid){window.__renderEleventyMermaid();}"
        >
          <span class="theme-label-dark">深色模式</span>
          <span class="theme-label-light">浅色模式</span>
        </button>
      </div>
    </header>

    <div class="shell">
      <aside class="sidebar" aria-label="文档章节导航">
        <div class="nav-group-label">基准章节 (eleventy-navigation)</div>
        {% set navPages = collections.all | eleventyNavigation %}
        <ul class="nav-list">
          {%- for entry in navPages -%}
            {{ renderNavItem(entry, page.url) }}
          {%- endfor -%}
        </ul>
      </aside>

      <main class="main-content">
        {%- if sectionBadge %}
        <div class="cascade-banner">
          <strong>{{ sectionBadge }}</strong>
          {%- if sectionContext %}
          <span>· {{ sectionContext }}</span>
          {%- endif %}
        </div>
        {%- endif %}
        <article class="doc-article">
          {{ content | safe }}
        </article>
      </main>

      <aside class="toc-aside">
        {%- if page.url != "/" and tocItems.length -%}
        <div class="toc-title">本页目录</div>
        <nav aria-label="本页目录">
          <ul class="toc-list">
            {%- for item in tocItems -%}
            <li class="toc-h{{ item.level }}">
              <a href="#{{ item.id }}">{{ item.text }}</a>
            </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- endif -%}
      </aside>
    </div>

    {%- if hasMermaid %}
    <script src="/assets/mermaid.min.js"></script>
    <script>
      (function () {
        try {
          var saved = localStorage.getItem('eleventy-benchmark-theme');
          var root = document.documentElement;
          if (saved === 'dark' && root.getAttribute('data-theme') !== 'dark') {
            root.classList.add('dark');
            root.setAttribute('data-theme', 'dark');
          }
        } catch (_) {}

        async function renderAllMermaid() {
          if (!window.mermaid) return;
          var wraps = document.querySelectorAll('.eleventy-mermaid-wrap');
          if (!wraps.length) return;
          var isDark =
            document.documentElement.getAttribute('data-theme') === 'dark' ||
            document.documentElement.classList.contains('dark');
          window.mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default',
            securityLevel: 'loose'
          });
          var idx = 0;
          for (var i = 0; i < wraps.length; i++) {
            var wrap = wraps[i];
            if (!wrap.dataset.mermaidSrc) {
              var pre = wrap.querySelector('pre.mermaid');
              wrap.dataset.mermaidSrc = pre ? pre.textContent || '' : '';
            }
            var src = wrap.dataset.mermaidSrc;
            if (!src.trim()) continue;
            try {
              var id = 'eleventy-mermaid-' + Date.now() + '-' + idx++;
              var out = await window.mermaid.render(id, src);
              wrap.innerHTML = out.svg;
            } catch (err) {
              console.error('Mermaid render failed:', err);
            }
          }
        }

        window.__renderEleventyMermaid = renderAllMermaid;
        void renderAllMermaid();

        var lastDark =
          document.documentElement.getAttribute('data-theme') === 'dark' ||
          document.documentElement.classList.contains('dark');
        new MutationObserver(function () {
          var nowDark =
            document.documentElement.getAttribute('data-theme') === 'dark' ||
            document.documentElement.classList.contains('dark');
          if (nowDark !== lastDark) {
            lastDark = nowDark;
            document.documentElement.classList.toggle('dark', nowDark);
            void renderAllMermaid();
          }
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme', 'class']
        });
      })();
    </script>
    {%- endif %}
  </body>
</html>
